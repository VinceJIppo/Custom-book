// GENERATED from prisma/schema.prisma by scripts/prisma-postgres.mjs. Do not edit.
// StoryStar data model.
// Dev uses SQLite; deploy uses Postgres. Avoid provider-specific features so the
// only change needed to switch is `provider` + DATABASE_URL.
// JSON columns are validated with Zod in /lib/schemas before use.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  name           String?
  ageConfirmedAt DateTime?
  /// Accounts can need an admin's approval before they can use anything that costs money:
  /// "approved" | "pending" | "rejected". Existing accounts default to approved.
  approval       String    @default("approved")
  approvalRequestedAt DateTime?
  /// Rewards: an admin can set a tier ("starter" | "member" | "star") regardless of orders.
  tierOverride   String?
  /// Rewards: extra allowance granted by an admin, on top of the tier.
  bonusBooks      Int      @default(0)
  bonusCharacters Int      @default(0)
  bonusRedraws    Int      @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  children ChildProfile[]
  books    Book[]
  themes   Theme[]
  jobs     GenerationJob[]
  orders   Order[]
  sessions Session[]
  creditLots      CreditLot[]
  creditEntries   CreditEntry[]
  creditPurchases CreditPurchase[]
}

/// Usage credits, in US dollars. Each grant is a lot with its own expiry; usage
/// draws from the lot that expires soonest. A "deficit" lot (negative, never
/// expires) records usage that ran past the balance and is paid off by the next grant.
model CreditLot {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// signup | order | purchase | admin | refund | deficit
  kind         String
  amountUsd    Float
  remainingUsd Float
  expiresAt    DateTime
  /// Makes grants idempotent, e.g. "signup:<userId>", "order:<orderId>", "purchase:<id>".
  sourceKey    String?  @unique
  note         String?
  createdAt    DateTime @default(now())

  @@index([userId, expiresAt])
}

/// Every change to a balance, for the history page and audits. Amounts are signed.
model CreditEntry {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// grant | usage | redeem | expire | refund
  kind      String
  amountUsd Float
  bookId    String?
  jobId     String?
  orderId   String?
  note      String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

/// A credit pack bought through the payment provider.
model CreditPurchase {
  id                String    @id @default(cuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  amountUsd         Float
  priceCents        Int
  /// awaiting_payment | paid | expired
  status            String    @default("awaiting_payment")
  paymentProvider   String
  checkoutSessionId String?   @unique
  paymentRef        String?
  createdAt         DateTime  @default(now())
  paidAt            DateTime?
}

/// One-time sign-in links. Only a hash of the token is stored.
model LoginToken {
  id        String    @id @default(cuid())
  email     String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email, createdAt])
}

/// Signed-in browsers. The cookie holds a random token; only its hash is stored.
model Session {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  @@index([userId])
}

model ChildProfile {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// "child" (a book can be made for them) or "grownup" (a parent, grandparent... who can star in a child's book)
  kind      String  @default("child")
  firstName String
  nickname  String?
  /// Grown-ups: who they are to the children, e.g. "Mom", "Grandpa"
  relationship String?
  /// Grown-ups: a few words about them (job, hobbies, personality), used by the story writer
  about     String?
  /// How they look, for people without a photo character
  look      String?
  /// Children: 1 to 12. Grown-ups: 0 (not used)
  age       Int
  pronouns  String // "he" | "she" | "they"
  /// { colors: string[], animals: string[], foods: string[], activities: string[] }
  favorites Json
  petName   String?
  petType   String?
  /// string[]
  friends   Json
  lesson    String?

  activeCharacterSheetId          String?
  deleteOriginalsAfterApproval    Boolean   @default(true)
  guardianConsentAt               DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  photos          ChildPhoto[]
  characterSheets CharacterSheet[]
  books           Book[]
  jobs            GenerationJob[]

  @@index([userId])
}

model ChildPhoto {
  id         String       @id @default(cuid())
  childId    String
  child      ChildProfile @relation(fields: [childId], references: [id], onDelete: Cascade)
  storageKey String
  width      Int
  height     Int
  /// Faces found by the photo check (null when no vision provider ran)
  faces      Int?
  createdAt  DateTime     @default(now())

  @@index([childId])
}

model CharacterSheet {
  id            String       @id @default(cuid())
  childId       String
  child         ChildProfile @relation(fields: [childId], references: [id], onDelete: Cascade)
  style         String
  outfit        String?
  /// Which generation round this is for the child and style (capped by CHARACTER_SHEET_MAX_ROUNDS)
  round         Int          @default(1)
  status        String       @default("generating") // generating | draft | approved | rejected | failed | deleted
  /// string[] storage keys, one per option
  imageKeys     Json
  selectedIndex Int?
  /// CharacterBible
  bible         Json?
  bibleStatus   String       @default("none") // none | pending | ready | failed
  costUsd       Float        @default(0)
  error         String?
  approvedAt    DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  books Book[]

  @@index([childId])
}

model License {
  id          String    @id @default(cuid())
  licensor    String
  scope       String
  /// string[] ISO country codes
  territories Json
  /// string[] product types
  products    Json
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())

  themes Theme[]
}

model Theme {
  id        String   @id @default(cuid())
  slug      String
  name      String
  /// ThemeConfig (validated by lib/schemas/theme.ts)
  config    Json
  isBuiltIn Boolean  @default(false)
  ownerId   String?
  owner     User?    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  licensed  Boolean  @default(false)
  licenseId String?
  license   License? @relation(fields: [licenseId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  books Book[]

  @@unique([slug, ownerId])
  @@index([ownerId])
}

model Book {
  id               String          @id @default(cuid())
  userId           String
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  childId          String
  child            ChildProfile    @relation(fields: [childId], references: [id], onDelete: Cascade)
  themeId          String
  theme            Theme           @relation(fields: [themeId], references: [id])
  /// Frozen copy of the theme config at creation time, so later theme edits never change a book.
  themeSnapshot    Json
  /// Frozen copy of the child details used for this book.
  childSnapshot    Json
  /// Frozen copies of the other people in the story (CastMemberSnapshot[]), with their character sheet ids
  castSnapshot     Json?
  characterSheetId String?
  characterSheet   CharacterSheet? @relation(fields: [characterSheetId], references: [id], onDelete: SetNull)
  style            String
  trimSize         String // see lib/print/geometry.ts TRIM_SIZES
  /// BookOptions
  options          Json
  title            String?
  dedication       String?
  backBlurb        String?
  /// Outline
  outline          Json?
  coverImageKey    String?
  status           String          @default("draft") // draft | generating | ready | failed
  version          Int             @default(1)
  shareEnabled     Boolean         @default(false)
  shareToken       String?         @unique
  estimatedCostUsd Float?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  pages   Page[]
  jobs    GenerationJob[]
  orders  Order[]
  exports BookExport[]

  @@index([userId])
  @@index([childId])
}

model Page {
  id          String   @id @default(cuid())
  bookId      String
  book        Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  /// Order within the book's logical page list (front matter, story, back matter).
  index       Int
  kind        String // belongsTo | dedication | title | story | theEnd
  /// 1-based story page number for kind=story
  storyNumber Int?
  text        String   @default("")
  /// SceneSpec
  scene       Json?
  layout      String
  textZone    String   @default("bottom")
  imageKey    String?
  imageStatus String   @default("none") // none | pending | ready | failed | flagged
  /// Likeness check against the character sheet: 0..1, and plain-English drift
  qaScore     Float?
  qaIssues    Json?
  /// Pre-upscale render kept for edits (smaller than the print file)
  workingImageKey String?
  version     Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  versions PageVersion[]
  jobs     GenerationJob[]

  @@index([bookId, index])
}

model PageVersion {
  id        String   @id @default(cuid())
  pageId    String
