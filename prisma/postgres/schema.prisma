  /// PreflightReport
  preflight          Json?
  preflightOk        Boolean  @default(false)
  validationStatus   String   @default("none") // none | running | passed | failed
  /// FileValidation from the print provider
  validation         Json?
  validationProgress String?
  /// The book content these files were made from; differs when the book was edited since.
  contentKey         String
  error              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([bookId])
}

model GenerationJob {
  id          String    @id @default(cuid())
