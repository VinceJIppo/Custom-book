}

/// A set of print files (interior + cover PDF) for one product, with its preflight and provider validation.
model BookExport {
  id                 String   @id @default(cuid())
  bookId             String
  book               Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  userId             String
  productId          String
  provider           String
  sku                String
  status             String   @default("rendering") // rendering | ready | failed
  pageCount          Int?
  interiorKey        String?
