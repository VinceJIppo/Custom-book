# StoryStar configuration. Copy to .env.local and fill in what you need.
# With nothing filled in, the whole app runs on Mock providers (no API keys).

# ---------------------------------------------------------------- App
APP_URL=http://localhost:3000
# SQLite path is relative to prisma/schema.prisma (this creates prisma/.data/dev.db).
# For Postgres: change `provider` in prisma/schema.prisma and use a postgres:// URL.
DATABASE_URL="file:./.data/dev.db"

# Phase 1 runs in single-user mode as this account (Auth.js replaces it in Phase 2).
SINGLE_USER_EMAIL=parent@storystar.local

# ---------------------------------------------------------------- Storage
# local (dev, encrypted files under STORAGE_LOCAL_DIR) or s3 (R2/S3, Phase 5)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.data/storage
# Required in production. Generate each with: openssl rand -base64 48
STORAGE_SIGNING_SECRET=
STORAGE_ENCRYPTION_KEY=
# How long signed image URLs stay valid (seconds, 30 to 3600).
SIGNED_URL_TTL_SECONDS=300
# S3-compatible (Phase 5)
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ---------------------------------------------------------------- Story (Claude)
# auto = use Claude when ANTHROPIC_API_KEY is set, otherwise the offline mock.
STORY_PROVIDER=auto
ANTHROPIC_API_KEY=
STORY_MODEL=claude-sonnet-5-5
# low | medium | high | xhigh | max. Higher = more thinking tokens = higher cost.
STORY_EFFORT=high
# Server-side refusal fallbacks (re-run a declined request on a fallback model in the same call).
STORY_FALLBACKS=true

# ---------------------------------------------------------------- Images (Phase 2)
# auto | mock. Real adapters (Gemini, OpenAI, FLUX, Ideogram) are added in Phase 2.
IMAGE_PROVIDER=auto
UPSCALER=auto
GEMINI_API_KEY=
OPENAI_API_KEY=
BFL_API_KEY=
IDEOGRAM_API_KEY=
REPLICATE_API_TOKEN=

# ---------------------------------------------------------------- Moderation
MODERATION_PROVIDER=auto

# ---------------------------------------------------------------- Print (Phase 3 and 4)
PRINT_PROVIDER=auto
LULU_API_BASE=https://api.sandbox.lulu.com
LULU_CLIENT_KEY=
LULU_CLIENT_SECRET=

# ---------------------------------------------------------------- Payments (Phase 4)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---------------------------------------------------------------- Auth (Phase 2)
AUTH_SECRET=
EMAIL_SERVER=
EMAIL_FROM=

# ---------------------------------------------------------------- Limits
# Per-user daily limits. Generation stops before either is exceeded.
DAILY_COST_CAP_USD=10
DAILY_BOOK_CAP=10

# ---------------------------------------------------------------- Worker
WORKER_CONCURRENCY=3
# Seconds a worker may hold a job before another worker can reclaim it.
JOB_LEASE_SECONDS=300
# Set to 1 for debug logs.
LOG_DEBUG=
