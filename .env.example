# StoryStar configuration. Copy to .env.local and fill in what you need.
# With nothing filled in, the whole app runs on Mock providers (no API keys).

# ---------------------------------------------------------------- App
APP_URL=http://localhost:3000
# SQLite path is relative to prisma/schema.prisma (this creates prisma/.data/dev.db).
# For Postgres: change `provider` in prisma/schema.prisma and use a postgres:// URL.
DATABASE_URL="file:./.data/dev.db"

# Phase 1 runs in single-user mode as this account (Auth.js replaces it in Phase 2).
SINGLE_USER_EMAIL=parent@storystar.local

# ---------------------------------------------------------------- Storage
# local (dev, encrypted files under STORAGE_LOCAL_DIR) or s3 (R2/S3, Phase 5)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.data/storage
# Required in production. Generate each with: openssl rand -base64 48
STORAGE_SIGNING_SECRET=
STORAGE_ENCRYPTION_KEY=
# How long signed image URLs stay valid (seconds, 30 to 3600).
SIGNED_URL_TTL_SECONDS=300
# S3-compatible (Phase 5)
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ---------------------------------------------------------------- Story (Claude)
# auto = use Claude when ANTHROPIC_API_KEY is set, otherwise the offline mock.
STORY_PROVIDER=auto
ANTHROPIC_API_KEY=
STORY_MODEL=claude-sonnet-5-5
# low | medium | high | xhigh | max. Higher = more thinking tokens = higher cost.
STORY_EFFORT=high
# Server-side refusal fallbacks (re-run a declined request on a fallback model in the same call).
STORY_FALLBACKS=true

# ---------------------------------------------------------------- Images
# auto = Gemini if GEMINI_API_KEY is set, else OpenAI if OPENAI_API_KEY is set, else mock.
# Or force one: mock | gemini | openai
IMAGE_PROVIDER=auto
# Google AI Studio key (paid tier: inputs are not used to improve Google's products).
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1
# Page art size: auto (4K for full pages and spreads, 2K for smaller art) | 1K | 2K | 4K
GEMINI_PAGE_SIZE=auto
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2.6-sunburst
# low | medium | high | xhigh | max | auto
OPENAI_IMAGE_QUALITY=high
# auto = local high-quality resize (sharp) with a real image provider, mock otherwise.
UPSCALER=auto
# How many character options to draw per set, and how many sets per art style.
CHARACTER_SHEET_OPTIONS=3
CHARACTER_SHEET_MAX_ROUNDS=3

# ---------------------------------------------------------------- Vision and moderation (Claude)
# Used for the one-face photo check, the page-vs-character likeness check, and
# moderation of parent text. auto = Claude when ANTHROPIC_API_KEY is set, else mock.
VISION_PROVIDER=auto
VISION_MODEL=claude-sonnet-5-5
VISION_EFFORT=medium
# Compare every page with the character sheet; redraw once on drift, then flag it.
CONSISTENCY_QA=true
MODERATION_PROVIDER=auto

# ---------------------------------------------------------------- Print (Lulu)
# auto = Lulu when both keys are set, else the offline mock. Or force: mock | lulu
PRINT_PROVIDER=auto
# Sandbox first: keys from https://developers.sandbox.lulu.com (a separate account from production).
LULU_API_BASE=https://api.sandbox.lulu.com
LULU_CLIENT_KEY=
LULU_CLIENT_SECRET=
# Lulu downloads the PDFs itself, so it needs a public address for this app.
# On a laptop, start a tunnel (see README) and paste its https URL here.
# Through this address the app serves ONLY signed PDF files and signed webhooks; everything else is 404.
PUBLIC_BASE_URL=
# How long the PDF links given to the printer stay valid (seconds). Photos never use this.
PRINT_FILE_URL_TTL_SECONDS=21600

# Offline mock printer: seconds between status steps (with the printer, printing, shipped, delivered).
MOCK_PRINT_STEP_SECONDS=60

# ---------------------------------------------------------------- Ordering and payments
# auto = Stripe when STRIPE_SECRET_KEY is set, else the offline test checkout. Or force: mock | stripe
PAYMENT_PROVIDER=auto
# TEST keys only (sk_test_...): Stripe dashboard > Developers > API keys, with "Test mode" on.
STRIPE_SECRET_KEY=
# Signing secret (whsec_...) of your webhook endpoint, or the one `stripe listen` prints.
STRIPE_WEBHOOK_SECRET=
# Safety switch. Live Stripe keys (sk_live_) and Lulu production are refused unless this is true.
ALLOW_LIVE_ORDERS=false
# Your margin on top of the printer's price (the customer sees one total).
ORDER_MARGIN_PERCENT=0
ORDER_MARGIN_FLAT_USD=0
# Add the card fee (2.9% + 30c) to the price so it doesn't come out of your pocket.
ORDER_COVER_CARD_FEES=true
# Email Lulu contacts about print problems (defaults to the parent's email).
ORDER_CONTACT_EMAIL=
# Comma-separated emails allowed on /admin/orders (empty: the single-user account).
ADMIN_EMAILS=
# How often the worker asks the printer for updates on open orders (webhooks are faster).
ORDER_POLL_MINUTES=30

# ---------------------------------------------------------------- Auth (sign-in; not used yet)
AUTH_SECRET=
EMAIL_SERVER=
EMAIL_FROM=

# ---------------------------------------------------------------- Limits
# Per-user daily limits. Generation stops before either is exceeded.
DAILY_COST_CAP_USD=10
DAILY_BOOK_CAP=10

# ---------------------------------------------------------------- Worker
WORKER_CONCURRENCY=3
# Seconds a worker may hold a job before another worker can reclaim it.
JOB_LEASE_SECONDS=300
# Set to 1 for debug logs.
LOG_DEBUG=
